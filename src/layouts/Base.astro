---
import "@fontsource-variable/montserrat";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alison Rane | Data Engineering, Automation & BI",
  description = "Alison Rane builds data platforms, automation, and business intelligence that help mission-driven organizations act on their data.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a535c" />
    <slot name="head" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alison Rane — Data Engineering, Automation & Business Intelligence" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Apply a saved theme before paint to avoid a flash.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <g stroke="var(--teal)" stroke-width="2.6" stroke-linecap="round">
              <line x1="6" y1="25" x2="16" y2="8"></line>
              <line x1="16" y1="8" x2="26" y2="25"></line>
              <line x1="6" y1="25" x2="26" y2="25"></line>
            </g>
            <g stroke="var(--bg)" stroke-width="2">
              <circle cx="6" cy="25" r="4.6" fill="var(--teal)"></circle>
              <circle cx="26" cy="25" r="4.6" fill="var(--teal)"></circle>
              <circle cx="16" cy="8" r="4.6" fill="var(--poppy)"></circle>
            </g>
          </svg>
          Alison Rane
        </a>
        <nav class="nav" aria-label="Main">
          <a class="hide-sm" href="/#toolkit">Toolkit</a>
          <a class="hide-sm" href="/#work">Work</a>
          <a class="hide-sm" href="/#speaking">Speaking</a>
          <a href="/resume/">Resume</a>
          <a href="/#contact">Contact</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Alison Rane</span>
        <span><a href="https://www.linkedin.com/in/alisonrane">LinkedIn</a> · <a href="https://github.com/alisonrane">GitHub</a></span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector(".theme-toggle");
        const current = () =>
          root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const sync = () => btn.setAttribute("aria-pressed", String(current() === "dark"));
        if (!root.dataset.theme) root.dataset.theme = current();
        sync();
        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          sync();
        });
      })();
    </script>
  </body>
</html>
